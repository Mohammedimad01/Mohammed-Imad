# Contact form delivery (optional). Get a free access key at https://web3forms.com
# then copy this file to .env.local and paste it below. Without it, the form
# opens the visitor's email app with the message pre-filled.
VITE_WEB3FORMS_KEY=

# Search engine ownership verification (optional). Paste only the content
# value of the meta tag each tool gives you; the build adds the tag to every page.
# Google Search Console: https://search.google.com/search-console
VITE_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (also feeds ChatGPT search and Copilot): https://www.bing.com/webmasters
VITE_BING_SITE_VERIFICATION=
